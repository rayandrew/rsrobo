{
  "bot_login": "rsrobo",
  "inbox_repo": "rayandrew/rsrobo-notes",
  "allowed_commenters": ["rayandrew"],
  "allowed_repos": ["*/*"],
  "default_post": "review",
  "default_budget_usd": 3,
  "max_budget_usd": 10,
  "min_severity": "P3",
  "effort": "high",
  "models": {
    "haiku": "claude-haiku-4-5-20251001",
    "sonnet": "claude-sonnet-5-5",
    "opus": "claude-opus-5-5",
    "luna": {
      "engine": "pi",
      "provider": "openai-codex",
      "model": "gpt-6-luna"
    },
    "sol": {
      "engine": "pi",
      "provider": "openai-codex",
      "model": "gpt-6-sol"
    },
    "kimi": {
      "engine": "pi",
      "provider": "freeinference",
      "model": "kimi-k2.7-code"
    },
    "or-sonnet": {
      "engine": "pi",
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-5.5"
    }
  },
  "pi_providers": ["openai-codex", "openrouter", "freeinference"],
  "default_model": "sonnet",
  "ask_model": "haiku",
  "verify_model": "sonnet",
  "repos": {
    "llnl-asr/dftracer-utils": {
      "post": "review",
      "kb": ["public"],
      "fix": ["patch", "suggest", "stacked", "push"],
      "providers": ["claude", "openai-codex", "openrouter"],
      "vendors": [
        "anthropic",
        "openai",
        "google",
        "x-ai",
        "meta-llama",
        "meta",
        "nvidia",
        "amazon",
        "microsoft",
        "perplexity",
        "cohere"
      ],
      "commits": {
        "types": [
          "feat",
          "fix",
          "perf",
          "refactor",
          "docs",
          "test",
          "build",
          "ci",
          "style",
          "chore",
          "revert",
          "bench",
          "release"
        ],
        "severity": "P1"
      }
    },
    "llnl-asr/*": {
