{
  "name": "rsrobo",
  "private": true,
  "type": "module",
  "bin": {
    "rsrobo": "src/cli.ts"
  },
  "scripts": {
    "rsrobo": "node src/cli.ts",
    "test": "node --test tests/*.test.ts poller/tests/*.test.ts",
    "lint": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc && tsc -p poller",
    "check": "biome check && tsc && tsc -p poller && node --test tests/*.test.ts poller/tests/*.test.ts",
    "deploy": "wrangler deploy -c poller/wrangler.toml"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  }
}
